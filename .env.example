# ============================================
# WAJIB DIISI UNTUK PRODUCTION
# ============================================

# Database (otomatis terisi dari Vercel Postgres)
POSTGRES_URL=postgres://user:pass@host:5432/dbname

# NextAuth — wajib generate random string yang panjang
# Bisa pakai: openssl rand -base64 32
NEXTAUTH_SECRET=ganti-dengan-random-string-panjang
NEXTAUTH_URL=https://your-domain.vercel.app

# ============================================
# INSTAGRAM API
# ============================================
INSTAGRAM_ACCESS_TOKEN=IGAAxxx_atau_EAAxxx
# Optional: untuk token EAA (Facebook), wajib isi User ID.
# Untuk token IGAA, otomatis pakai "me".
INSTAGRAM_USER_ID=

# ============================================
# GOOGLE GEMINI AI
# ============================================
GEMINI_API_KEY=AIzaSy...

# ============================================
# GOOGLE DRIVE
# ============================================
# ID folder publik (dari URL drive.google.com/drive/folders/<ID>)
GOOGLE_DRIVE_FOLDER_ID=

# ============================================
# CRON & INIT (untuk security)
# ============================================
# Random secret untuk endpoint cron auto-posting
CRON_SECRET=ganti-dengan-random-string

# Random secret untuk endpoint /api/init
INIT_SECRET=ganti-dengan-random-string-lainnya

# Password admin pertama (akan di-hash). Ganti setelah login.
INIT_ADMIN_PASSWORD=GantiPasswordIni123!

# ============================================
# DEV ONLY — JANGAN SET DI PRODUCTION!
# ============================================
# DEV_BYPASS_AUTH=true
